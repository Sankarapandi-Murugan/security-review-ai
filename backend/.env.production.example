# Production environment template for Vigil AI
# Copy this file to backend/.env.production and replace all placeholder values.
# NEVER commit real secrets to source control.

# Required production mode and security settings
SECURITY_REVIEW_ENVIRONMENT=production
SECURITY_REVIEW_LOG_LEVEL=INFO
SECURITY_REVIEW_AUTH_REQUIRED=true

# Generate strong secrets with:
#   openssl rand -hex 32
#   openssl rand -hex 32
# and keep each value unique.
SECURITY_REVIEW_JWT_SECRET=replace-with-a-strong-random-secret-at-least-32-chars
SECURITY_REVIEW_API_KEY=replace-with-a-long-random-api-key
SECURITY_REVIEW_WEBHOOK_SECRET=replace-with-a-long-random-webhook-secret

# Production database: use managed Postgres, not SQLite.
DATABASE_URL=postgresql+psycopg://vigil:change-me-strong-password@prod-postgres-host:5432/vigil

# Production cache / rate-limit backend: Redis in production if shared state is required.
REDIS_URL=redis://prod-redis-host:6379/0

# Payment provider: choose mock for local-only/demo use, or stripe for real billing.
SECURITY_REVIEW_PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=replace-with-your-stripe-secret-key
STRIPE_PRICE_ID_PRO=replace-with-your-pro-price-id
STRIPE_WEBHOOK_SECRET=replace-with-your-stripe-webhook-secret

# Email delivery for password reset / notifications
SECURITY_REVIEW_EMAIL_PROVIDER=smtp
SECURITY_REVIEW_SMTP_HOST=smtp.example.com
SECURITY_REVIEW_SMTP_PORT=587
SECURITY_REVIEW_SMTP_USERNAME=your-smtp-username
SECURITY_REVIEW_SMTP_PASSWORD=your-smtp-password
SECURITY_REVIEW_SMTP_FROM_ADDRESS=no-reply@example.com

# Observability / release tracking
SECURITY_REVIEW_SENTRY_DSN=

# Optional tuning
SECURITY_REVIEW_RATE_LIMIT_ENABLED=true
SECURITY_REVIEW_MAX_LOGIN_ATTEMPTS=10
SECURITY_REVIEW_MAX_SIGNUP_ATTEMPTS=5
