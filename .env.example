SECURITY_REVIEW_ENVIRONMENT=development
SECURITY_REVIEW_AUTH_REQUIRED=false
SECURITY_REVIEW_API_KEY=demo-key
SECURITY_REVIEW_WEBHOOK_SECRET=change-me-in-production
SECURITY_REVIEW_JWT_SECRET=change-me-to-a-random-32-byte-secret-in-production
SECURITY_REVIEW_REPO_WORKDIR=data/repos
SECURITY_REVIEW_GIT_CLONE_TIMEOUT_SECONDS=120
SECURITY_REVIEW_LOGIN_RATE_LIMIT=10
SECURITY_REVIEW_LOGIN_RATE_WINDOW_SECONDS=60
SECURITY_REVIEW_SIGNUP_RATE_LIMIT=5
SECURITY_REVIEW_SIGNUP_RATE_WINDOW_SECONDS=60

# Production values should be set in backend/.env.production and must never use these dev defaults.
# Required production settings:
#   SECURITY_REVIEW_ENVIRONMENT=production
#   SECURITY_REVIEW_JWT_SECRET=<strong random value, min 32 chars>
#   SECURITY_REVIEW_API_KEY=<strong random value>
#   SECURITY_REVIEW_WEBHOOK_SECRET=<strong random value>
#   DATABASE_URL=postgresql+psycopg://user:password@host:5432/dbname
#   REDIS_URL=redis://host:6379/0
#   SECURITY_REVIEW_PAYMENT_PROVIDER=stripe  # if real billing is enabled
#   STRIPE_SECRET_KEY=sk_live_...
#   STRIPE_PRICE_ID_PRO=price_...
#   STRIPE_WEBHOOK_SECRET=whsec_...
#   SECURITY_REVIEW_EMAIL_PROVIDER=smtp
#   SECURITY_REVIEW_SMTP_HOST=smtp.example.com
#   SECURITY_REVIEW_SMTP_PORT=587
#   SECURITY_REVIEW_SMTP_USERNAME=apikey
#   SECURITY_REVIEW_SMTP_PASSWORD=change-me
#   SECURITY_REVIEW_SMTP_FROM_ADDRESS=noreply@example.com

# Uncomment for a production-like Postgres/Redis deployment (see README):
# DATABASE_URL=postgresql+psycopg://vigil:vigil@localhost:5432/vigil
# REDIS_URL=redis://localhost:6379/0
# Uncomment for real Stripe billing (see README "Plans & billing"); otherwise
# billing uses the no-payment MockPaymentProvider:
# SECURITY_REVIEW_PAYMENT_PROVIDER=stripe
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PRICE_ID_PRO=price_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# Uncomment for real password-reset emails (see README "Password reset"); otherwise
# reset links are only logged (ConsoleEmailProvider), not actually emailed:
# SECURITY_REVIEW_EMAIL_PROVIDER=smtp
# SECURITY_REVIEW_SMTP_HOST=smtp.example.com
# SECURITY_REVIEW_SMTP_PORT=587
# SECURITY_REVIEW_SMTP_USERNAME=apikey
# SECURITY_REVIEW_SMTP_PASSWORD=change-me
# SECURITY_REVIEW_SMTP_FROM_ADDRESS=noreply@example.com

